# HealthGPT environment configuration
# Copy to .env locally. NEVER commit real API keys.

# Gemini Developer API (free tier available; rate limits apply)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Local default database. Use PostgreSQL in production if desired.
DATABASE_URL=sqlite:///./healthgpt.db

# Production session secret
SESSION_SECRET=replace-with-a-long-random-secret

# Optional OpenAI-compatible provider
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
