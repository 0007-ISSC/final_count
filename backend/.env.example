# HealthGPT environment configuration
# Copy to .env locally. NEVER commit real API keys.

# Gemini Developer API (free tier available; rate limits apply)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional PostgreSQL/Supabase connection. If omitted, local SQLite is used.
DATABASE_URL=sqlite:///./healthgpt.db

# Optional compatibility settings if another OpenAI-compatible provider is used.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
