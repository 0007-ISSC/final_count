{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access control",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["patient", "doctor", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "createdAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Clinical appointment reservation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "doctorId": { "type": "number" },
        "doctorName": { "type": "string" },
        "specialty": { "type": "string" },
        "hospital": { "type": "string" },
        "date": { "type": "string" },
        "timeSlot": { "type": "string" },
        "mode": { "type": "string" },
        "tokenNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "doctorId", "doctorName", "date", "timeSlot", "status"]
    },
    "HealthRecord": {
      "title": "HealthRecord",
      "description": "Biometric telemetry and physiological vitals",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "vitalityScore": { "type": "number" },
        "heartRate": { "type": "number" },
        "bloodPressure": { "type": "string" },
        "sleepHours": { "type": "number" },
        "hydrationLiters": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "timestamp"]
    },
    "ScienceDossier": {
      "title": "ScienceDossier",
      "description": "DeepMind Science bioinformatics dossiers, AlphaFold 3D predictions, and clinical target studies",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "targetName": { "type": "string" },
        "uniprotId": { "type": "string" },
        "pdbId": { "type": "string" },
        "organism": { "type": "string" },
        "functionSummary": { "type": "string" },
        "plddtScore": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "targetName", "createdAt"]
    },
    "Prescription": {
      "title": "Prescription",
      "description": "Verified digital prescription and Jan Aushadhi generic substitutions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "medicineName": { "type": "string" },
        "genericSalt": { "type": "string" },
        "dosage": { "type": "string" },
        "frequency": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "medicineName", "dosage"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document owned by authenticated user"
    },
    "/users/{userId}/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Clinical appointments booked by user"
    },
    "/users/{userId}/healthRecords/{recordId}": {
      "schema": "HealthRecord",
      "description": "Biometric telemetry snapshots"
    },
    "/users/{userId}/scienceDossiers/{dossierId}": {
      "schema": "ScienceDossier",
      "description": "Bioinformatics and molecular targets saved by user"
    },
    "/users/{userId}/prescriptions/{prescriptionId}": {
      "schema": "Prescription",
      "description": "Prescription records and generic alternatives"
    }
  }
}
