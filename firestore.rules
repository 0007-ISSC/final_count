rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        (request.auth.token.role == 'admin' || 
         request.auth.token.email == 'admin@healthgpt.ai');
    }

    // Public test probe for connection validation
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow delete: if isAdmin();
      
      match /appointments/{appointmentId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if (isOwner(userId) || isAdmin()) && isValidId(appointmentId);
      }
      
      match /healthRecords/{recordId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if (isOwner(userId) || isAdmin()) && isValidId(recordId);
      }
      
      match /scienceDossiers/{dossierId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if (isOwner(userId) || isAdmin()) && isValidId(dossierId);
      }
      
      match /prescriptions/{prescriptionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if (isOwner(userId) || isAdmin()) && isValidId(prescriptionId);
      }
    }
  }
}
